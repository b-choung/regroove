# Supabase 대시보드 > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=
# 같은 화면의 API Keys > Publishable key (브라우저에 노출되는 키. RLS가 접근을 막는다)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# console.anthropic.com > API keys
# 없어도 앱은 동작한다 — 공고 파싱 2단계(LLM 추출)만 건너뛰고 수동 입력으로 넘어간다.
ANTHROPIC_API_KEY=

# 데모 계정 (선택). 로그인 화면의 "가입 없이 둘러보기" 버튼에 쓰인다.
# Supabase > Authentication > Users > Add user 로 만들고(Auto Confirm 켜기),
# supabase/seeds/demo.sql 로 예시 데이터를 넣는다.
# 비밀번호는 서버에서만 읽는다 — NEXT_PUBLIC_을 붙이면 브라우저 번들에 박힌다.
# 둘 중 하나라도 비어 있으면 버튼이 표시되지 않는다.
DEMO_EMAIL=
DEMO_PASSWORD=
